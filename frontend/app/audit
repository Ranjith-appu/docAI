"use client";

import React, { useEffect, useState } from "react";
import { ScrollText, CheckCircle2, ShieldAlert, Search, RefreshCw, Hash } from "lucide-react";
import { api } from "../../services/api";
import { AuditLogItem } from "../../types";

export default function AuditTrailPage() {
  const [logs, setLogs] = useState<AuditLogItem[]>([]);
  const [loading, setLoading] = useState(true);
  const [chainStatus, setChainStatus] = useState<{
    chain_intact: boolean;
    total_verified_entries: number;
    status: string;
    description: string;
  } | null>(null);

  const [filterAction, setFilterAction] = useState("");
  const [searchQuery, setSearchQuery] = useState("");

  const fetchLogs = async () => {
    try {
      setLoading(true);
      const [logsData, chainData] = await Promise.all([
        api.getAuditLogs(undefined, filterAction || undefined),
        api.verifyAuditChain(),
      ]);
      setLogs(logsData);
      setChainStatus(chainData);
    } catch (err) {
      console.error("Audit fetch error:", err);
    } finally {
      setLoading(false);
    }
  };

  useEffect(() => {
    fetchLogs();
  }, [filterAction]);

  const filteredLogs = logs.filter((l) => {
    if (!searchQuery.trim()) return true;
    const q = searchQuery.toLowerCase();
    return (
      (l.action && l.action.toLowerCase().includes(q)) ||
      (l.case_id && l.case_id.toLowerCase().includes(q)) ||
      (l.entry_hash && l.entry_hash.toLowerCase().includes(q))
    );
  });

  return (
    <div className="space-y-6 max-w-6xl mx-auto">
      {/* Header */}
      <div className="flex flex-col md:flex-row md:items-center md:justify-between gap-4">
        <div>
          <h1 className="text-2xl font-bold text-white tracking-tight flex items-center gap-3">
            <ScrollText className="w-6 h-6 text-blue-400" />
            <span>Cryptographic Audit Trail</span>
          </h1>
          <p className="text-xs text-slate-400 mt-1">
            Tamper-evident append-only hash-chained sequence recording every operational and AI event
          </p>
        </div>

        {/* Chain Integrity Badge */}
        {chainStatus && (
          <div
            className={`flex items-center space-x-2 px-3.5 py-1.5 rounded-xl border text-xs font-mono ${
              chainStatus.chain_intact
                ? "bg-emerald-950/40 border-emerald-800 text-emerald-300"
                : "bg-rose-950/60 border-rose-800 text-rose-300"
            }`}
          >
            {chainStatus.chain_intact ? (
              <CheckCircle2 className="w-4 h-4 text-emerald-400" />
            ) : (
              <ShieldAlert className="w-4 h-4 text-rose-400" />
            )}
            <span>
              {chainStatus.status}: {chainStatus.total_verified_entries} BLOCKS INTACT
            </span>
          </div>
        )}
      </div>

      {/* Filters & Search */}
      <div className="flex flex-col md:flex-row items-center justify-between gap-4 bg-slate-900 p-4 rounded-xl border border-slate-800">
        <div className="relative flex-1 w-full md:max-w-md">
          <Search className="w-4 h-4 text-slate-500 absolute left-3 top-3" />
          <input
            type="text"
            value={searchQuery}
            onChange={(e) => setSearchQuery(e.target.value)}
            placeholder="Search by action, case ID, or SHA-256 hash..."
            className="w-full bg-slate-950 border border-slate-700 rounded-lg pl-9 pr-3 py-2 text-xs text-slate-100 placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-blue-500 font-mono"
          />
        </div>

        <div className="flex items-center space-x-2 overflow-x-auto w-full md:w-auto">
          {[
            "",
            "CREATE_CASE",
            "UPLOAD_DOCUMENT",
            "OCR_COMPLETED",
            "TAMPERING_ANALYSIS_COMPLETED",
            "FACE_VERIFICATION_COMPLETED",
            "RISK_CALCULATED",
            "BLOCKCHAIN_REGISTERED",
            "OFFICER_REVIEW",
          ].map((act) => (
            <button
              key={act}
              onClick={() => setFilterAction(act)}
              className={`px-3 py-1.5 rounded-lg text-xs font-mono transition-colors whitespace-nowrap ${
                filterAction === act
                  ? "bg-blue-600 text-white font-semibold"
                  : "bg-slate-950 text-slate-400 hover:text-slate-200 border border-slate-800"
              }`}
            >
              {act ? act.replace(/_/g, " ") : "ALL ACTIONS"}
            </button>
          ))}
        </div>
      </div>

      {/* Audit Log Table */}
      <div className="bg-slate-900 border border-slate-800 rounded-xl overflow-hidden shadow-xl">
        <div className="overflow-x-auto">
          <table className="w-full text-left border-collapse text-xs font-mono">
            <thead>
              <tr className="border-b border-slate-800 bg-slate-950/70 text-slate-400 uppercase tracking-wider">
                <th className="py-3 px-4">Timestamp (UTC)</th>
                <th className="py-3 px-4">Action</th>
                <th className="py-3 px-4">Case ID</th>
                <th className="py-3 px-4">Entry Hash (SHA-256)</th>
                <th className="py-3 px-4">Details</th>
              </tr>
            </thead>
            <tbody className="divide-y divide-slate-800/60">
              {filteredLogs.map((l) => (
                <tr key={l.id} className="hover:bg-slate-800/40 transition-colors">
                  <td className="py-3 px-4 text-slate-400 whitespace-nowrap">
                    {new Date(l.timestamp).toLocaleString()}
                  </td>
                  <td className="py-3 px-4">
                    <span className="px-2 py-0.5 rounded bg-blue-950/60 border border-blue-800 text-blue-300 font-bold text-[11px]">
                      {l.action}
                    </span>
                  </td>
                  <td className="py-3 px-4 text-slate-300">
                    {l.case_id ? (
                      <span className="truncate block max-w-[140px]">{l.case_id}</span>
                    ) : (
                      "-"
                    )}
                  </td>
                  <td className="py-3 px-4 text-emerald-400">
                    <span title={l.entry_hash} className="truncate block max-w-[150px]">
                      {l.entry_hash.slice(0, 16)}...
                    </span>
                  </td>
                  <td className="py-3 px-4 text-slate-400 text-[11px]">
                    <span className="truncate block max-w-[280px]">
                      {JSON.stringify(l.details)}
                    </span>
                  </td>
                </tr>
              ))}

              {filteredLogs.length === 0 && !loading && (
                <tr>
                  <td colSpan={5} className="py-10 text-center text-slate-500 font-mono">
                    No matching audit log entries.
                  </td>
                </tr>
              )}
            </tbody>
          </table>
        </div>
      </div>
    </div>
  );
}
