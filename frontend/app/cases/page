"use client";

import React, { useEffect, useState } from "react";
import Link from "next/link";
import { FolderLock, Search, PlusCircle, Filter } from "lucide-react";
import { api } from "../../services/api";
import { StatusBadge } from "../../components/StatusBadge";
import { CaseItem } from "../../types";

export default function CasesListPage() {
  const [cases, setCases] = useState<CaseItem[]>([]);
  const [loading, setLoading] = useState(true);
  const [statusFilter, setStatusFilter] = useState("");
  const [searchTerm, setSearchTerm] = useState("");

  const fetchCases = async () => {
    try {
      setLoading(true);
      const data = await api.getCases(statusFilter || undefined, searchTerm || undefined);
      setCases(data);
    } catch (err) {
      console.error("Failed to fetch cases:", err);
    } finally {
      setLoading(false);
    }
  };

  useEffect(() => {
    fetchCases();
  }, [statusFilter]);

  const handleSearchSubmit = (e: React.FormEvent) => {
    e.preventDefault();
    fetchCases();
  };

  return (
    <div className="space-y-6">
      {/* Header */}
      <div className="flex flex-col md:flex-row md:items-center md:justify-between gap-4">
        <div>
          <h1 className="text-2xl font-bold text-white tracking-tight flex items-center gap-2.5">
            <FolderLock className="w-6 h-6 text-blue-400" />
            <span>Screening Cases Registry</span>
          </h1>
          <p className="text-xs text-slate-400 mt-1">
            Searchable repository of all processed travel identities and investigative screening dossiers
          </p>
        </div>

        <Link
          href="/screening"
          className="flex items-center space-x-2 px-4 py-2 rounded-lg bg-blue-600 hover:bg-blue-500 text-xs font-semibold text-white shadow-lg shadow-blue-600/30 transition-all self-start"
        >
          <PlusCircle className="w-4 h-4" />
          <span>New Screening</span>
        </Link>
      </div>

      {/* Filters & Search Bar */}
      <div className="flex flex-col md:flex-row items-center justify-between gap-4 bg-slate-900 p-4 rounded-xl border border-slate-800">
        {/* Search */}
        <form onSubmit={handleSearchSubmit} className="relative flex-1 w-full md:max-w-md">
          <Search className="w-4 h-4 text-slate-500 absolute left-3 top-3" />
          <input
            type="text"
            value={searchTerm}
            onChange={(e) => setSearchTerm(e.target.value)}
            placeholder="Search by Case Number or Applicant Name..."
            className="w-full bg-slate-950 border border-slate-700 rounded-lg pl-9 pr-3 py-2 text-xs text-slate-100 placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-blue-500 font-mono"
          />
        </form>

        {/* Status Filter Tabs */}
        <div className="flex items-center space-x-2 overflow-x-auto w-full md:w-auto">
          {["", "VERIFIED", "SUSPICIOUS", "REVIEW_REQUIRED", "PROCESSING"].map((st) => (
            <button
              key={st}
              onClick={() => setStatusFilter(st)}
              className={`px-3 py-1.5 rounded-lg text-xs font-mono transition-colors whitespace-nowrap ${
                statusFilter === st
                  ? "bg-blue-600 text-white font-semibold"
                  : "bg-slate-950 text-slate-400 hover:text-slate-200 border border-slate-800"
              }`}
            >
              {st ? st.replace("_", " ") : "ALL CASES"}
            </button>
          ))}
        </div>
      </div>

      {/* Cases Table */}
      <div className="bg-slate-900 border border-slate-800 rounded-xl overflow-hidden shadow-xl">
        <div className="overflow-x-auto">
          <table className="w-full text-left border-collapse text-xs">
            <thead>
              <tr className="border-b border-slate-800 bg-slate-950/70 font-mono text-slate-400 uppercase tracking-wider">
                <th className="py-3 px-6">Case Number</th>
                <th className="py-3 px-6">Applicant Name</th>
                <th className="py-3 px-6">Document Type</th>
                <th className="py-3 px-6">Status</th>
                <th className="py-3 px-6">Date Registered</th>
                <th className="py-3 px-6 text-right">Actions</th>
              </tr>
            </thead>
            <tbody className="divide-y divide-slate-800/60">
              {cases.map((c) => (
                <tr key={c.id} className="hover:bg-slate-800/40 transition-colors">
                  <td className="py-3.5 px-6 font-mono font-bold text-blue-400">
                    <Link href={`/cases/${c.id}`} className="hover:underline">
                      {c.case_number}
                    </Link>
                  </td>
                  <td className="py-3.5 px-6 font-medium text-slate-200">{c.applicant_name}</td>
                  <td className="py-3.5 px-6 font-mono text-slate-400">{c.document_type}</td>
                  <td className="py-3.5 px-6">
                    <StatusBadge status={c.status} />
                  </td>
                  <td className="py-3.5 px-6 text-slate-400 font-mono">
                    {new Date(c.created_at).toLocaleString()}
                  </td>
                  <td className="py-3.5 px-6 text-right">
                    <Link
                      href={`/cases/${c.id}`}
                      className="px-3 py-1 rounded bg-slate-800 hover:bg-slate-700 text-slate-200 font-mono text-[11px] transition-colors"
                    >
                      Inspect Dossier →
                    </Link>
                  </td>
                </tr>
              ))}

              {cases.length === 0 && !loading && (
                <tr>
                  <td colSpan={6} className="py-12 text-center text-slate-500 font-mono">
                    No matching screening dockets found.
                  </td>
                </tr>
              )}
            </tbody>
          </table>
        </div>
      </div>
    </div>
  );
}
