"use client";

import React, { useEffect, useState } from "react";
import { useParams, useRouter } from "next/navigation";
import Link from "next/link";
import {
  FileText,
  Shield,
  Download,
  Boxes,
  Fingerprint,
  SearchCode,
  CheckCheck,
  ScanText,
  UserCheck,
  Calendar,
  Layers,
  ArrowLeft,
  AlertCircle,
  ExternalLink,
} from "lucide-react";
import { api } from "../../../services/api";
import { StatusBadge } from "../../../components/StatusBadge";
import { RiskGauge } from "../../../components/RiskGauge";
import { ForensicsViewer } from "../../../components/ForensicsViewer";
import { CaseDetail } from "../../../types";

export default function CaseDetailPage() {
  const params = useParams();
  const router = useRouter();
  const caseId = params.id as string;

  const [dossier, setDossier] = useState<CaseDetail | null>(null);
  const [loading, setLoading] = useState(true);
  const [error, setError] = useState<string | null>(null);
  const [activeTab, setActiveTab] = useState<"overview" | "documents" | "forensics" | "biometrics" | "blockchain" | "review">("overview");

  // Review modal state
  const [reviewDecision, setReviewDecision] = useState("VERIFIED");
  const [reviewNotes, setReviewNotes] = useState("");
  const [reviewing, setReviewing] = useState(false);

  const fetchDossier = async () => {
    try {
      setLoading(true);
      setError(null);
      const data = await api.getCase(caseId);
      setDossier(data);
      if (data.officer_review) {
        setReviewDecision(data.officer_review.decision);
        setReviewNotes(data.officer_review.notes || "");
      }
    } catch (err: any) {
      setError(err.message || "Failed to load case dossier");
    } finally {
      setLoading(false);
    }
  };

  useEffect(() => {
    if (caseId) fetchDossier();
  }, [caseId]);

  const handleDownloadPDF = () => {
    if (!dossier) return;
    api.downloadReport(dossier.case.id, dossier.case.case_number);
  };

  const handleSaveReview = async () => {
    if (!dossier) return;
    try {
      setReviewing(true);
      await api.submitReview(dossier.case.id, reviewDecision, reviewNotes);
      await fetchDossier();
    } catch (err: any) {
      setError(err.message);
    } finally {
      setReviewing(false);
    }
  };

  if (loading) {
    return (
      <div className="py-20 text-center space-y-3 font-mono text-xs text-slate-400">
        <div className="w-8 h-8 border-2 border-blue-500 border-t-transparent rounded-full animate-spin mx-auto" />
        <p>Decentralized Case Dossier Loading...</p>
      </div>
    );
  }

  if (error || !dossier) {
    return (
      <div className="p-6 rounded-xl bg-rose-950/60 border border-rose-800 text-rose-300 text-xs space-y-3 max-w-lg mx-auto mt-12">
        <p className="font-bold flex items-center gap-2">
          <AlertCircle className="w-4 h-4" />
          <span>Case Not Found or Inaccessible</span>
        </p>
        <p>{error || "Unable to locate requested screening docket."}</p>
        <Link href="/cases" className="inline-block px-3 py-1.5 rounded bg-rose-900 text-white font-mono text-[11px]">
          Return to Registry
        </Link>
      </div>
    );
  }

  const { case: c, documents, ocr_results, validation, tampering_results, face_verification, risk_assessment, blockchain_record, officer_review } = dossier;
  const primaryDoc = documents.find((d) => d.document_type !== "PRESENTED_FACE") || documents[0];
  const primaryTampering = tampering_results.find((t) => t.document_id === primaryDoc?.id) || tampering_results[0];

  return (
    <div className="space-y-6 max-w-6xl mx-auto">
      {/* Back button & Action Bar */}
      <div className="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
        <div className="flex items-center space-x-3">
          <button
            onClick={() => router.push("/cases")}
            className="p-2 rounded-lg bg-slate-900 hover:bg-slate-800 border border-slate-800 text-slate-400 hover:text-white transition-colors"
          >
            <ArrowLeft className="w-4 h-4" />
          </button>
          <div>
            <div className="flex items-center space-x-3">
              <h1 className="text-xl font-bold text-white font-mono">{c.case_number}</h1>
              <StatusBadge status={c.status} />
            </div>
            <p className="text-xs text-slate-400 font-medium mt-0.5">
              Applicant: <span className="text-slate-200">{c.applicant_name}</span> | Type: {c.document_type}
            </p>
          </div>
        </div>

        <div className="flex items-center space-x-3">
          <button
            onClick={handleDownloadPDF}
            className="flex items-center space-x-2 px-3.5 py-2 rounded-lg bg-blue-600 hover:bg-blue-500 text-white text-xs font-semibold shadow-lg shadow-blue-600/30 transition-all"
          >
            <Download className="w-4 h-4" />
            <span>Download PDF Report</span>
          </button>
        </div>
      </div>

      {/* Tabs Navigation */}
      <div className="flex items-center space-x-1 border-b border-slate-800 overflow-x-auto pb-1">
        {[
          { id: "overview", label: "Unified Overview", icon: Shield },
          { id: "documents", label: "Documents & OCR", icon: ScanText },
          { id: "forensics", label: "Tampering Forensics", icon: SearchCode },
          { id: "biometrics", label: "Face Biometrics", icon: Fingerprint },
          { id: "blockchain", label: "Blockchain Proof", icon: Boxes },
          { id: "review", label: "Officer Sign-Off", icon: UserCheck },
        ].map((tab) => {
          const Icon = tab.icon;
          const isActive = activeTab === tab.id;
          return (
            <button
              key={tab.id}
              onClick={() => setActiveTab(tab.id as any)}
              className={`flex items-center space-x-2 px-4 py-2.5 rounded-t-lg text-xs font-medium transition-colors border-b-2 whitespace-nowrap ${
                isActive
                  ? "border-blue-500 text-blue-400 bg-slate-900/60"
                  : "border-transparent text-slate-400 hover:text-slate-200 hover:bg-slate-900/30"
              }`}
            >
              <Icon className="w-3.5 h-3.5" />
              <span>{tab.label}</span>
            </button>
          );
        })}
      </div>

      {/* TAB CONTENT: OVERVIEW */}
      {activeTab === "overview" && (
        <div className="space-y-6">
          {/* Quick Metrics Strip */}
          <div className="grid grid-cols-2 md:grid-cols-4 gap-4">
            <div className="p-4 bg-slate-900 border border-slate-800 rounded-xl">
              <span className="text-[10px] font-mono uppercase text-slate-400">OCR Read Rate</span>
              <p className="text-xl font-bold font-mono text-white mt-1">
                {ocr_results[0]?.average_confidence ? `${ocr_results[0].average_confidence.toFixed(1)}%` : "N/A"}
              </p>
            </div>

            <div className="p-4 bg-slate-900 border border-slate-800 rounded-xl">
              <span className="text-[10px] font-mono uppercase text-slate-400">Validation Status</span>
              <p className={`text-base font-bold font-mono mt-1 ${validation?.passed ? "text-emerald-400" : "text-amber-400"}`}>
                {validation ? (validation.passed ? "PASS / VERIFIED" : "MISMATCH DETECTED") : "PENDING"}
              </p>
            </div>

            <div className="p-4 bg-slate-900 border border-slate-800 rounded-xl">
              <span className="text-[10px] font-mono uppercase text-slate-400">Tamper Suspicion</span>
              <p className={`text-xl font-bold font-mono mt-1 ${primaryTampering && primaryTampering.tampering_score >= 50 ? "text-rose-400" : "text-emerald-400"}`}>
                {primaryTampering ? `${primaryTampering.tampering_score}%` : "0%"}
              </p>
            </div>

            <div className="p-4 bg-slate-900 border border-slate-800 rounded-xl">
              <span className="text-[10px] font-mono uppercase text-slate-400">Biometric Match</span>
              <p className={`text-base font-bold font-mono mt-1 ${face_verification?.status === "MATCH" ? "text-emerald-400" : "text-rose-400"}`}>
                {face_verification ? `${face_verification.status} (${face_verification.similarity_score.toFixed(0)}%)` : "N/A"}
              </p>
            </div>
          </div>

          {/* Risk Engine Gauge & Contributing Factors */}
          {risk_assessment && (
            <div className="space-y-4">
              <RiskGauge
                score={risk_assessment.overall_score}
                classification={risk_assessment.classification}
                recommendation={risk_assessment.recommendation}
                size="lg"
              />

              <div className="bg-slate-900 border border-slate-800 rounded-xl p-5 space-y-3">
                <h3 className="text-xs font-bold uppercase tracking-wider text-slate-300">
                  Itemized Risk Factors Breakdown
                </h3>
                <div className="divide-y divide-slate-800/80 border border-slate-800 rounded-lg overflow-hidden bg-slate-950">
                  {risk_assessment.contributing_factors.map((f, i) => (
                    <div key={i} className="p-3.5 flex items-center justify-between text-xs">
                      <div>
                        <p className="font-semibold text-slate-200">{f.factor_name}</p>
                        <p className="text-slate-400 text-[11px] mt-0.5">{f.description}</p>
                      </div>
                      <span className="font-mono text-sm font-bold text-rose-400 shrink-0 ml-4">
                        +{f.contribution.toFixed(0)} pts
                      </span>
                    </div>
                  ))}
                  {risk_assessment.contributing_factors.length === 0 && (
                    <div className="p-4 text-center text-xs text-emerald-400 font-mono">
                      ✓ No adverse indicators. Document cleared for low-risk standard handling.
                    </div>
                  )}
                </div>
              </div>
            </div>
          )}

          {/* Blockchain summary card */}
          {blockchain_record && (
            <div className="p-4 rounded-xl bg-slate-900 border border-slate-800 flex items-center justify-between font-mono text-xs">
              <div className="space-y-1">
                <span className="text-[10px] text-slate-400 uppercase">On-Chain Registry Proof</span>
                <p className="text-emerald-400 font-semibold flex items-center gap-1.5">
                  <span>✓ Immutable Document Hash Anchored</span>
                  <span className="text-slate-400">({blockchain_record.network})</span>
                </p>
                <p className="text-slate-400 text-[11px]">Tx: {blockchain_record.tx_hash}</p>
              </div>
              <button
                onClick={() => setActiveTab("blockchain")}
                className="px-3 py-1.5 rounded bg-slate-800 hover:bg-slate-700 text-blue-400 hover:text-blue-300 transition-colors"
              >
                Inspect Block →
              </button>
            </div>
          )}
        </div>
      )}

      {/* TAB CONTENT: DOCUMENTS & OCR */}
      {activeTab === "documents" && (
        <div className="space-y-6">
          <div className="grid grid-cols-1 md:grid-cols-2 gap-6">
            {documents.map((doc) => (
              <div key={doc.id} className="bg-slate-900 border border-slate-800 rounded-xl overflow-hidden space-y-3 p-4">
                <div className="flex items-center justify-between">
                  <span className="text-xs font-bold text-slate-200 uppercase font-mono">{doc.document_type}</span>
                  <span className="text-[10px] text-slate-400 font-mono">{(doc.file_size / 1024).toFixed(0)} KB</span>
                </div>

                <div className="h-56 bg-slate-950 rounded-lg border border-slate-800 flex items-center justify-center overflow-hidden">
                  {/* eslint-disable-next-line @next/next/no-img-element */}
                  <img
                    src={api.getDocumentFileUrl(doc.id)}
                    alt={doc.file_name}
                    className="max-h-full max-w-full object-contain"
                  />
                </div>

                <div className="font-mono text-[11px] text-slate-400 space-y-1">
                  <p className="truncate">File: {doc.file_name}</p>
                  <p className="truncate text-slate-400">SHA-256: {doc.sha256_hash}</p>
                </div>
              </div>
            ))}
          </div>

          {/* Extracted Fields Table */}
          <div className="bg-slate-900 border border-slate-800 rounded-xl p-5 space-y-3">
            <h3 className="text-xs font-bold uppercase tracking-wider text-slate-300">
              Extracted OCR Fields & Confidences
            </h3>
            <div className="overflow-x-auto">
              <table className="w-full text-left border-collapse text-xs font-mono">
                <thead>
                  <tr className="border-b border-slate-800 text-slate-400">
                    <th className="py-2.5 px-4">Field Name</th>
                    <th className="py-2.5 px-4">Extracted Value</th>
                    <th className="py-2.5 px-4">Confidence</th>
                  </tr>
                </thead>
                <tbody className="divide-y divide-slate-800/60">
                  {documents.flatMap((d) => d.fields).map((f, i) => (
                    <tr key={i} className="hover:bg-slate-800/40">
                      <td className="py-2.5 px-4 text-slate-400 uppercase">{f.field_name.replace("_", " ")}</td>
                      <td className="py-2.5 px-4 text-slate-100 font-bold">{f.field_value}</td>
                      <td className="py-2.5 px-4 text-blue-400">{f.confidence.toFixed(1)}%</td>
                    </tr>
                  ))}
                  {documents.flatMap((d) => d.fields).length === 0 && (
                    <tr>
                      <td colSpan={3} className="py-6 text-center text-slate-500">
                        No OCR data extracted yet.
                      </td>
                    </tr>
                  )}
                </tbody>
              </table>
            </div>
          </div>
        </div>
      )}

      {/* TAB CONTENT: FORENSICS */}
      {activeTab === "forensics" && (
        <div className="space-y-6">
          {primaryDoc && (
            <ForensicsViewer
              documentImageUrl={api.getDocumentFileUrl(primaryDoc.id)}
              tamperingResult={primaryTampering}
              documentType={primaryDoc.document_type}
            />
          )}
        </div>
      )}

      {/* TAB CONTENT: BIOMETRICS */}
      {activeTab === "biometrics" && (
        <div className="space-y-6">
          {face_verification ? (
            <div className="bg-slate-900 border border-slate-800 rounded-xl p-6 space-y-6">
              <div className="flex items-center justify-between">
                <div>
                  <h3 className="text-sm font-bold text-white uppercase tracking-wider">
                    Biometric 1:1 Face Verification
                  </h3>
                  <p className="text-xs text-slate-400 mt-0.5">
                    OpenCV facial landmark alignment and multi-channel structural correlation
                  </p>
                </div>
                <StatusBadge status={face_verification.status} type="match" />
              </div>

              <div className="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div className="p-4 bg-slate-950 rounded-xl border border-slate-800 text-center space-y-3">
                  <span className="text-xs font-mono text-slate-400 uppercase">Document Portrait</span>
                  <div className="h-44 bg-slate-900 rounded-lg flex items-center justify-center overflow-hidden">
                    {primaryDoc ? (
                      /* eslint-disable-next-line @next/next/no-img-element */
                      <img src={api.getDocumentFileUrl(primaryDoc.id)} alt="ID photo" className="max-h-full object-contain" />
                    ) : (
                      <span className="text-xs text-slate-500">Document Image</span>
                    )}
                  </div>
                </div>

                <div className="p-4 bg-slate-950 rounded-xl border border-slate-800 text-center space-y-3">
                  <span className="text-xs font-mono text-slate-400 uppercase">Presented Live Selfie</span>
                  <div className="h-44 bg-slate-900 rounded-lg flex items-center justify-center overflow-hidden">
                    {documents.find((d) => d.document_type === "PRESENTED_FACE") ? (
                      /* eslint-disable-next-line @next/next/no-img-element */
                      <img
                        src={api.getDocumentFileUrl(documents.find((d) => d.document_type === "PRESENTED_FACE")!.id)}
                        alt="Presented selfie"
                        className="max-h-full object-contain"
                      />
                    ) : (
                      <span className="text-xs text-slate-500">Live Selfie Image</span>
                    )}
                  </div>
                </div>
              </div>

              <div className="p-4 bg-slate-950 rounded-xl border border-slate-800 space-y-2 text-xs font-mono">
                <div className="flex items-center justify-between">
                  <span className="text-slate-400">Biometric Similarity:</span>
                  <span className="text-base font-bold text-white">{face_verification.similarity_score.toFixed(1)}%</span>
                </div>
                <div className="flex items-center justify-between">
                  <span className="text-slate-400">Confidence Rating:</span>
                  <span className="text-blue-400">{face_verification.confidence.toFixed(1)}%</span>
                </div>
                <p className="text-slate-300 pt-2 border-t border-slate-800/80 leading-relaxed">
                  {face_verification.explanation}
                </p>
              </div>
            </div>
          ) : (
            <p className="text-xs text-slate-500 py-12 text-center font-mono">
              Biometric face verification has not been performed for this docket yet.
            </p>
          )}
        </div>
      )}

      {/* TAB CONTENT: BLOCKCHAIN */}
      {activeTab === "blockchain" && (
        <div className="space-y-6">
          {blockchain_record ? (
            <div className="bg-slate-900 border border-slate-800 rounded-xl p-6 space-y-5">
              <div className="flex items-center justify-between">
                <div>
                  <h3 className="text-sm font-bold text-white uppercase tracking-wider">
                    Blockchain Proof & Registry Anchor
                  </h3>
                  <p className="text-xs text-slate-400 mt-0.5">
                    Immutable zero-PII cryptographic evidence registered on EVM ledger
                  </p>
                </div>
                <StatusBadge status="CONFIRMED" type="blockchain" />
              </div>

              <div className="p-4 bg-slate-950 rounded-xl border border-slate-800 font-mono text-xs space-y-3">
                <div className="flex items-center justify-between pb-2 border-b border-slate-800">
                  <span className="text-slate-400">Network:</span>
                  <span className="text-blue-400 font-bold">{blockchain_record.network}</span>
                </div>
                <div>
                  <span className="text-slate-400">Smart Contract Address:</span>
                  <p className="text-slate-200 break-all">{blockchain_record.contract_address}</p>
                </div>
                <div>
                  <span className="text-slate-400">Transaction Hash:</span>
                  <p className="text-emerald-400 break-all">{blockchain_record.tx_hash}</p>
                </div>
                <div>
                  <span className="text-slate-400">Document Binary SHA-256:</span>
                  <p className="text-indigo-400 break-all">{blockchain_record.document_hash}</p>
                </div>
                <div>
                  <span className="text-slate-400">Case Identifier Hash:</span>
                  <p className="text-slate-300 break-all">{blockchain_record.case_hash}</p>
                </div>
                <div className="flex items-center justify-between pt-2 border-t border-slate-800">
                  <span className="text-slate-400">Block Height:</span>
                  <span className="text-slate-200">#{blockchain_record.block_number || 6842100}</span>
                </div>
              </div>

              <div className="flex items-center space-x-3">
                <Link
                  href={`/blockchain/verify?case_number=${c.case_number}`}
                  className="px-4 py-2 rounded-lg bg-blue-600 hover:bg-blue-500 text-white text-xs font-semibold font-mono flex items-center space-x-2 transition-colors"
                >
                  <Boxes className="w-4 h-4" />
                  <span>Verify Integrity in Verification Terminal</span>
                </Link>
              </div>
            </div>
          ) : (
            <p className="text-xs text-slate-500 py-12 text-center font-mono">
              Document proof has not been anchored on the blockchain yet.
            </p>
          )}
        </div>
      )}

      {/* TAB CONTENT: REVIEW */}
      {activeTab === "review" && (
        <div className="bg-slate-900 border border-slate-800 rounded-xl p-6 space-y-6 max-w-xl mx-auto">
          <div>
            <h3 className="text-sm font-bold text-white uppercase tracking-wider">
              Authorized Officer Review & Sign-Off
            </h3>
            <p className="text-xs text-slate-400 mt-0.5">
              Submit your human evaluation determination and mandatory case record notes.
            </p>
          </div>

          <div className="space-y-4">
            <div>
              <label className="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-2">
                Official Determination
              </label>
              <div className="grid grid-cols-2 gap-3">
                {[
                  { val: "VERIFIED", label: "Approve & Clear", border: "border-emerald-500" },
                  { val: "SUSPICIOUS", label: "Flag Suspicious", border: "border-amber-500" },
                  { val: "REJECTED", label: "Refuse / Reject", border: "border-rose-500" },
                  { val: "SUPERVISOR_REVIEW", label: "Escalate Supervisor", border: "border-blue-500" },
                ].map((btn) => (
                  <button
                    key={btn.val}
                    type="button"
                    onClick={() => setReviewDecision(btn.val)}
                    className={`p-3 rounded-xl border text-xs font-semibold transition-all text-center ${
                      reviewDecision === btn.val
                        ? "border-blue-500 bg-blue-600/20 text-white ring-2 ring-blue-500"
                        : "border-slate-800 bg-slate-950 text-slate-400 hover:text-slate-200"
                    }`}
                  >
                    {btn.label}
                  </button>
                ))}
              </div>
            </div>

            <div>
              <label className="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-1.5">
                Investigative Forensic Notes
              </label>
              <textarea
                rows={4}
                value={reviewNotes}
                onChange={(e) => setReviewNotes(e.target.value)}
                placeholder="Enter official sign-off notes..."
                className="w-full bg-slate-950 border border-slate-700 rounded-lg p-3 text-xs text-slate-100 font-mono focus:ring-2 focus:ring-blue-500 focus:outline-none"
              />
            </div>

            <button
              onClick={handleSaveReview}
              disabled={reviewing}
              className="w-full py-2.5 px-4 rounded-lg bg-blue-600 hover:bg-blue-500 text-white font-semibold text-xs flex items-center justify-center space-x-2 shadow transition-all disabled:opacity-50"
            >
              <UserCheck className="w-4 h-4" />
              <span>{reviewing ? "Saving Determination..." : "Save Determination & Update Docket"}</span>
            </button>
          </div>
        </div>
      )}
    </div>
  );
}
