"use client";

import React, { useEffect, useState } from "react";
import { LineChart, BarChart3, PieChart, ShieldCheck, AlertTriangle, Boxes, Clock, Fingerprint, ScanEye } from "lucide-react";
import { api } from "../../services/api";
import { AnalyticsData } from "../../types";

export default function AnalyticsPage() {
  const [data, setData] = useState<AnalyticsData | null>(null);
  const [loading, setLoading] = useState(true);

  useEffect(() => {
    api.getAnalytics()
      .then(setData)
      .catch(console.error)
      .finally(() => setLoading(false));
  }, []);

  return (
    <div className="space-y-8 max-w-6xl mx-auto">
      <div>
        <h1 className="text-2xl font-bold text-white tracking-tight flex items-center gap-3">
          <LineChart className="w-6 h-6 text-blue-400" />
          <span>Screening Operations Analytics</span>
        </h1>
        <p className="text-xs text-slate-400 mt-1">
          Aggregated biometric match trends, tampering detection patterns, and blockchain anchoring volume
        </p>
      </div>

      {/* KPI Cards */}
      <div className="grid grid-cols-2 md:grid-cols-4 gap-4">
        <div className="bg-slate-900 border border-slate-800 rounded-xl p-4">
          <span className="text-xs font-mono uppercase text-slate-400">Total Cases Evaluated</span>
          <p className="text-3xl font-bold font-mono text-white mt-1">{data?.total_screenings || 0}</p>
        </div>

        <div className="bg-slate-900 border border-slate-800 rounded-xl p-4">
          <span className="text-xs font-mono uppercase text-slate-400">Tampering Detection Rate</span>
          <p className="text-3xl font-bold font-mono text-amber-400 mt-1">
            {data?.total_screenings ? ((data.tampering_detected_count / data.total_screenings) * 100).toFixed(1) : 0}%
          </p>
          <span className="text-[10px] text-slate-500 font-mono">{data?.tampering_detected_count || 0} flagged</span>
        </div>

        <div className="bg-slate-900 border border-slate-800 rounded-xl p-4">
          <span className="text-xs font-mono uppercase text-slate-400">Face Mismatch Rate</span>
          <p className="text-3xl font-bold font-mono text-rose-400 mt-1">
            {data?.total_screenings ? ((data.face_mismatch_count / data.total_screenings) * 100).toFixed(1) : 0}%
          </p>
          <span className="text-[10px] text-slate-500 font-mono">{data?.face_mismatch_count || 0} mismatches</span>
        </div>

        <div className="bg-slate-900 border border-slate-800 rounded-xl p-4">
          <span className="text-xs font-mono uppercase text-slate-400">Blockchain Anchoring</span>
          <p className="text-3xl font-bold font-mono text-indigo-400 mt-1">
            {data?.blockchain_registrations_count || 0}
          </p>
          <span className="text-[10px] text-indigo-400/80 font-mono">100% on-chain proof</span>
        </div>
      </div>

      {/* Charts Grid */}
      <div className="grid grid-cols-1 md:grid-cols-2 gap-6">
        {/* Daily Trend Chart (CSS Bar Chart) */}
        <div className="bg-slate-900 border border-slate-800 rounded-xl p-5 space-y-4">
          <div className="flex items-center justify-between">
            <h3 className="text-xs font-bold uppercase tracking-wider text-slate-300">
              Daily Screening Volume (Last 7 Days)
            </h3>
            <span className="text-[10px] text-slate-500 font-mono">Real-Time</span>
          </div>

          <div className="flex items-end justify-between h-48 pt-6 px-2">
            {data?.daily_trend?.map((d) => {
              const maxVal = Math.max(...(data.daily_trend.map(t => t.screenings) || [1]), 5);
              const heightPct = Math.max(10, Math.round((d.screenings / maxVal) * 100));

              return (
                <div key={d.date} className="flex flex-col items-center space-y-2 flex-1">
                  <span className="text-[11px] font-mono text-blue-400 font-bold">{d.screenings}</span>
                  <div className="w-8 bg-slate-800 rounded-t-md overflow-hidden flex items-end h-32">
                    <div
                      className="w-full bg-gradient-to-t from-blue-600 to-indigo-500 rounded-t-md transition-all duration-500"
                      style={{ height: `${heightPct}%` }}
                    />
                  </div>
                  <span className="text-[10px] font-mono text-slate-400">{d.date}</span>
                </div>
              );
            })}
          </div>
        </div>

        {/* Risk Classification Distribution */}
        <div className="bg-slate-900 border border-slate-800 rounded-xl p-5 space-y-4">
          <div className="flex items-center justify-between">
            <h3 className="text-xs font-bold uppercase tracking-wider text-slate-300">
              Risk Classification Distribution
            </h3>
            <span className="text-[10px] text-slate-500 font-mono">All Cases</span>
          </div>

          <div className="space-y-3 pt-2">
            {[
              { label: "Low Risk (Cleared)", count: data?.risk_distribution?.LOW || 0, color: "bg-emerald-500", text: "text-emerald-400" },
              { label: "Medium Risk (Verification)", count: data?.risk_distribution?.MEDIUM || 0, color: "bg-amber-500", text: "text-amber-400" },
              { label: "High Risk (Manual Review)", count: data?.risk_distribution?.HIGH || 0, color: "bg-orange-500", text: "text-orange-400" },
              { label: "Critical Risk (Refused)", count: data?.risk_distribution?.CRITICAL || 0, color: "bg-rose-500", text: "text-rose-400" },
            ].map((r) => {
              const total = data?.total_screenings || 1;
              const pct = Math.round((r.count / total) * 100);

              return (
                <div key={r.label} className="space-y-1">
                  <div className="flex items-center justify-between text-xs font-mono">
                    <span className="text-slate-300">{r.label}</span>
                    <span className={`font-bold ${r.text}`}>{r.count} ({pct}%)</span>
                  </div>
                  <div className="w-full h-2 bg-slate-800 rounded-full overflow-hidden">
                    <div className={`h-full ${r.color}`} style={{ width: `${Math.max(4, pct)}%` }} />
                  </div>
                </div>
              );
            })}
          </div>
        </div>
      </div>
    </div>
  );
}
